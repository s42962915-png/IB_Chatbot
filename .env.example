# --- OpenAI / knowledge base ---
OPENAI_API_KEY=sk-your-key
VECTOR_STORE_ID=vs_your_vector_store_id
OPENAI_MODEL=gpt-4.1-mini
MAX_RESULTS=8

# --- Security ---
# Optional shared secret the widget must send. Set the SAME value in the
# widget config (window.InBodyChatConfig.token) when embedding on public sites.
WIDGET_TOKEN=

# Comma-separated allowed origins. "*" lets any website embed the widget
# (use it together with WIDGET_TOKEN).
CORS_ORIGINS=*

# Simple per-client rate limit (requests per minute).
RATE_LIMIT_PER_MINUTE=20

# --- Local preview ---
# When true, /api/chat returns a canned demo answer if no key/store is set,
# so you can preview the widget end-to-end before configuring OpenAI.
DEMO_MODE=false
